# Copy to .env and fill in. Never commit .env.

# Model provider: "ollama" (local, default) or "aistudio" (Gemma via Google AI Studio)
PROVIDER=ollama
MODEL=gemma3:4b
OLLAMA_URL=http://localhost:11434

# Only needed when PROVIDER=aistudio (model e.g. gemma-3-4b-it)
GEMINI_API_KEY=

# ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# GitHub fine-grained token, public repos read-only (avoids rate limits)
GITHUB_TOKEN=
